# Copy this file to .env before running Docker Compose.
# Generate a secret: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DB_PASSWORD=replace-with-a-strong-database-password
REPLICATE_API_TOKEN=replace-with-your-replicate-token

DB_NAME=ecompho_db
DB_USER=ecompho
FRONTEND_PORT=8080

# Replace with your server domain for deployment. Include every hostname used to reach the site.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Optional provider key
GEMINI_API_KEY=
